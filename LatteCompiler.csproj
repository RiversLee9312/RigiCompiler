<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- stdlib 内嵌源（M43）：LogicalName 保持路径形态（stdlib/core/Console.latte），
       StdlibSources 据此反推 sourceName -->
  <ItemGroup>
    <EmbeddedResource Include="stdlib/**/*.latte" LogicalName="stdlib/%(RecursiveDir)%(FileName)%(Extension)" />
  </ItemGroup>

</Project>
