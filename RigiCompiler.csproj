<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>rigic</AssemblyName>
  </PropertyGroup>

  <!-- Release 发布：NativeAOT 原生单文件（注意：不支持跨 OS 交叉编译，
       linux-x64 产物必须在 Linux 上构建，win-x64 同理）。
       反射保留：AstJsonlSerializer/AstJsonlDeserializer/ASTIntegrityValidator 等依赖
       Assembly.GetTypes() / Activator.CreateInstance / 字段属性反射，
       由 ILLink.Roots.xml（preserve="all"）保住本程序集全部类型与成员元数据；
       JsonSerializerIsReflectionEnabledByDefault 强开 STJ 反射序列化（AOT 下默认禁用，
       禁用即运行时抛 InvalidOperationException）。AOT 无 JIT 的运行时优化
       （去虚拟化/PGO），重接口分派的路径（如 SemanticsFuzz）比 CoreCLR 慢约 3 倍。 -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)'=='Release'">
    <TrimmerRootDescriptor Include="ILLink.Roots.xml" />
  </ItemGroup>

  <!-- stdlib 内嵌源（M43）：LogicalName 保持路径形态（stdlib/core/Console.rg），
       StdlibSources 据此反推 sourceName -->
  <ItemGroup>
    <EmbeddedResource Include="stdlib/**/*.rg" LogicalName="stdlib/%(RecursiveDir)%(FileName)%(Extension)" />
  </ItemGroup>

  <!-- Middleware（BIL → 原生）唯一第三方依赖豁免（MIDDLEWARE_ARCHITECTURE §2）：
       LLVMSharp 进程内绑定 + libLLVM 原生库，锁定 LLVM 20；libLLVM 元包按 RID
       传递分发（win-x64/linux-x64），NativeAOT 发布形态为「AOT exe + libLLVM 边车」。
       显式引用两个 runtime 包：libLLVM 元包经 runtime.json 传递原生资产，只在
       带 RID 的 restore/发布时解析；无 RID 的 dotnet build/run 开发回路需要直接
       引用才能把 libLLVM.dll/.so 复制到输出目录（构建按当前平台 RID 二选一） -->
  <ItemGroup>
    <PackageReference Include="LLVMSharp.Interop" Version="20.1.2" />
    <PackageReference Include="libLLVM.runtime.win-x64" Version="20.1.2" />
    <PackageReference Include="libLLVM.runtime.linux-x64" Version="20.1.2" />
  </ItemGroup>

</Project>
