priv var caseUpperPool: Array\<i64> = core.collections.arrayOfElements\<i64>(2, 83, 83, 2, 700, 78, 2, 74, 780, 3, 921, 776, 769, 3, 933, 776, 769, 2, 1333, 1362, 2, 72, 817, 2, 84, 776, 2, 87, 778, 2, 89, 778, 2, 65, 702, 2, 933, 787, 3, 933, 787, 768, 3, 933, 787, 769, 3, 933, 787, 834, 2, 7944, 921, 2, 7945, 921, 2, 7946, 921, 2, 7947, 921, 2, 7948, 921, 2, 7949, 921, 2, 7950, 921, 2, 7951, 921, 2, 7944, 921, 2, 7945, 921, 2, 7946, 921, 2, 7947, 921, 2, 7948, 921, 2, 7949, 921, 2, 7950, 921, 2, 7951, 921, 2, 7976, 921, 2, 7977, 921, 2, 7978, 921, 2, 7979, 921, 2, 7980, 921, 2, 7981, 921, 2, 7982, 921, 2, 7983, 921, 2, 7976, 921, 2, 7977, 921, 2, 7978, 921, 2, 7979, 921, 2, 7980, 921, 2, 7981, 921, 2, 7982, 921, 2, 7983, 921, 2, 8040, 921, 2, 8041, 921, 2, 8042, 921, 2, 8043, 921, 2, 8044, 921, 2, 8045, 921, 2, 8046, 921, 2, 8047, 921, 2, 8040, 921, 2, 8041, 921, 2, 8042, 921, 2, 8043, 921, 2, 8044, 921, 2, 8045, 921, 2, 8046, 921, 2, 8047, 921, 2, 8122, 921, 2, 913, 921, 2, 902, 921, 2, 913, 834, 3, 913, 834, 921, 2, 913, 921, 2, 8138, 921, 2, 919, 921, 2, 905, 921, 2, 919, 834, 3, 919, 834, 921, 2, 919, 921, 3, 921, 776, 768, 3, 921, 776, 769, 2, 921, 834, 3, 921, 776, 834, 3, 933, 776, 768, 3, 933, 776, 769, 2, 929, 787, 2, 933, 834, 3, 933, 776, 834, 2, 8186, 921, 2, 937, 921, 2, 911, 921, 2, 937, 834, 3, 937, 834, 921, 2, 937, 921, 2, 70, 70, 2, 70, 73, 2, 70, 76, 3, 70, 70, 73, 3, 70, 70, 76, 2, 83, 84, 2, 83, 84, 2, 1348, 1350, 2, 1348, 1333, 2, 1348, 1339, 2, 1358, 1350, 2, 1348, 1341)

// ===== 查表入口（internal：供 text.rg 的 toLower/toUpper 调用，编译单元内可见）=====
// 映射算法在 Rigi 层完成，VM 与 native 共用本表（Rigi 实现即双宿主同源，
// 不需要 C 侧副本）。

// 二分查找 cp 落入的区间下标（keys 升序、区间互不重叠）；返回 -1 表示
// 小于首区间。是否真正落入区间由调用方用 ends 判定（cp < ends[hit]）
priv func caseFindRange(keys: Array\<i64>, cp: i64): i64 {
    var lo: i64 = (0 as i64)
    var hi: i64 = ((keys.length as i64) - (1 as i64))
    var hit: i64 = (-1 as i64)
    while (lo <= hi) {
        const mid: i64 = ((lo + hi) / (2 as i64))
        if ((keys[(mid as i32)] as i64) <= cp) {
            hit = mid
            lo = (mid + (1 as i64))
        } else {
            hi = (mid - (1 as i64))
        }
    }
    return hit
}

// 方向数组选择（四支平行数组同选）：false = toLower，true = toUpper。
// 两个入口各自用局部 if 选择（Rigi 参数句柄不外溢，直接改写局部变量）

// 映射目标标量个数：0 = 无映射（保持不变），1..3 = 目标标量数
internal func caseMapCount(toUpper: bool, cp: i64): i64 {
    var keys: Array\<i64> = caseLowerKeys
    var ends: Array\<i64> = caseLowerEnds
    var vals: Array\<i64> = caseLowerVals
    var pool: Array\<i64> = caseLowerPool
    if (toUpper) {
        keys = caseUpperKeys
        ends = caseUpperEnds
        vals = caseUpperVals
        pool = caseUpperPool
    }
    const hit = caseFindRange(keys, cp)
    if (hit < (0 as i64)) { return (0 as i64) }
    if (cp >= (ends[(hit as i32)] as i64)) { return (0 as i64) }
    const val = (vals[(hit as i32)] as i64)
    if ((val & (1 as i64)) == (1 as i64)) { return (1 as i64) }
    // 偶数编码：展开池槽首元素即目标标量个数
    return (pool[((val >> (1 as i64)) as i32)] as i64)
}

// 第 index 个目标标量（前提：caseMapCount 同参结果 > 0 且 index < 个数）
internal func caseMapTarget(toUpper: bool, cp: i64, index: i64): i64 {
    var keys: Array\<i64> = caseLowerKeys
    var ends: Array\<i64> = caseLowerEnds
    var vals: Array\<i64> = caseLowerVals
    var pool: Array\<i64> = caseLowerPool
    if (toUpper) {
        keys = caseUpperKeys
        ends = caseUpperEnds
        vals = caseUpperVals
        pool = caseUpperPool
    }
    const hit = caseFindRange(keys, cp)
    if ((hit < (0 as i64)) or (cp >= (ends[(hit as i32)] as i64))) {
        throw new core.OutOfBoundException("case 大小写查表与计数前提不符：cp=${cp}")
    }
    const val = (vals[(hit as i32)] as i64)
    if ((val & (1 as i64)) == (1 as i64)) {
        // 奇数编码：delta 区间——目标 = 标量 + delta
        const delta: i64 = ((val >> (1 as i64)) - (65536 as i64))
        return (cp + delta)
    }
    const off: i64 = (val >> (1 as i64))
    const n = (pool[(off as i32)] as i64)
    if ((index < (0 as i64)) or (index >= n)) {
        throw new core.OutOfBoundException("case 展开目标下标越界：index=${index} n=${n}")
    }
    return (pool[(((off + (1 as i64)) + index) as i32)] as i64)
}

