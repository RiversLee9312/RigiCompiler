    <type fullname="RigiCompiler.Tests.ASTIntegrityValidatorTests/UnannotatedFieldNode" preserve="all" />
    <type fullname="RigiCompiler.Tests.ASTIntegrityValidatorTests/UnannotatedPropertyNode" preserve="all" />
    <type fullname="RigiCompiler.Tests.ASTIntegrityValidatorTests/MisannotatedNode" preserve="all" />
  </assembly>
</linker>
